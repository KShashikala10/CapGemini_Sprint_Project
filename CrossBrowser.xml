<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM
        "https://testng.org/testng-1.0.dtd">

<suite name="Cross Browser Suite"
       parallel="tests"
       thread-count="3">

    <test name="Chrome Test">

        <parameter name="browser" value="chrome"/>

        <classes>
            <class name="ecom.SwagLabs.Login.UserLoginWithValidCredentials_Test"/>
            <class name="ecom.SwagLabs.Product.ProductShoppingFlow_Test"/>
            <class name="ecom.SwagLabs.Cart.CompletePurchaseFlow_Test"/>
            <class name="ecom.SwagLabs.UserOptions.OpenUserOptions_Test"/>
        </classes>

    </test>


    <test name="Firefox Test">

        <parameter name="browser" value="firefox"/>

        <classes>
            <class name="ecom.SwagLabs.Login.UserLoginWithValidCredentials_Test"/>
            <class name="ecom.SwagLabs.Product.ProductShoppingFlow_Test"/>
            <class name="ecom.SwagLabs.Cart.CompletePurchaseFlow_Test"/>
            <class name="ecom.SwagLabs.UserOptions.OpenUserOptions_Test"/>
        </classes>

    </test>


    <test name="Edge Test">

        <parameter name="browser" value="edge"/>

        <classes>
            <class name="ecom.SwagLabs.Login.UserLoginWithValidCredentials_Test"/>
            <class name="ecom.SwagLabs.Product.ProductShoppingFlow_Test"/>
            <class name="ecom.SwagLabs.Cart.CompletePurchaseFlow_Test"/>
            <class name="ecom.SwagLabs.UserOptions.OpenUserOptions_Test"/>
        </classes>

    </test>

</suite>